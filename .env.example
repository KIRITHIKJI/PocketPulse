# PocketPulse environment variables — copy to .env.local and fill in real values.
# Placeholders only. Never commit real keys. (.env.local is gitignored.)
# Find these in Supabase Dashboard → Project Settings → API Keys.

# Public Supabase project settings (safe in the browser; data is protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Server-only secret key. NEVER prefix with NEXT_PUBLIC_ and never import it from client code.
SUPABASE_SECRET_KEY=sb_secret_your-key-here

# Public site URL used for auth redirects (password recovery, email confirmation)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
